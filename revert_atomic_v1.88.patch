+        {
+            if (sem->m_next == m_wait_semaphores.front())
+            {
+                sem = NULL;
+                break;
+            }
+
+            sem = sem->m_next;
+        }
+    }
+
+    if (!sem)
+    {
+        if (BOOST_LIKELY(!m_free_semaphores.empty()))
+        {
+            sem = m_free_semaphores.pop_front();
