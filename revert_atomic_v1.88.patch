+            list->push_front(sem);
+        }
+    }
+    else if (sem->m_waiter_count == 0u)
+    {
+        // Move the semaphore to the free list
+        m_wait_semaphores.erase(sem);
+        m_free_semaphores.push_front(sem);
+    }
