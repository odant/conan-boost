 <p><code class="computeroutput"> c_decor[ stream &lt;&lt; <a class="link" href="attr_8hpp_1a4092770e33ec0ec13894eebf01050a76.html" title="Function template attr">attr&lt; std::string &gt;</a>("MyAttr") ] </code></p>
